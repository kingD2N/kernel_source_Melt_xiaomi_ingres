# LEDs
CONFIG_LEDS_AW_22XXX=m

# Game key
CONFIG_INPUT_XM_GAMEKEY=m

# Power
CONFIG_BQ_FG_2S=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# CONFIG_ARCH_CAPE is not set
# CONFIG_ARCH_DIWALI is not set

# ROM build: WLAN dibangun dari kernel/xiaomi/sm8450-modules (qca6490/qca6750)
# CONFIG_QCA_CLD_WLAN is not set

# ROM build: compiler AOSP bisa beda dengan compiler Melt; peringatan jangan
# menggagalkan build
# CONFIG_WERROR is not set
